// =========================
// MODO ESCURO
// =========================

function modoEscuro() {
    document.body.classList.toggle("dark");
}


// =========================
// AUMENTAR FONTE
// =========================

let tamanhoFonte = 16;

function aumentarFonte() {

    tamanhoFonte += 2;

    document.body.style.fontSize = tamanhoFonte + "px";

}

function diminuirFonte() {

    if (tamanhoFonte > 14) {

        tamanhoFonte -= 2;

        document.body.style.fontSize = tamanhoFonte + "px";

    }

}


// =========================
// PORTAL DE ESCUTA
// =========================

function acolher() {

    let texto = document.getElementById("desabafo").value;

    let mensagem = document.getElementById("mensagem");

    if (texto.trim() == "") {

        mensagem.innerHTML =
        "⚠️ Escreva alguma coisa antes de enviar.";

        mensagem.style.color = "red";

        return;

    }

    mensagem.innerHTML = `
    💙 Obrigado por compartilhar seus sentimentos!

    <br><br>

    Lembre-se:
    conversar com um professor, pedagogo,
    direção da escola, familiares ou outro
    adulto de confiança pode fazer toda
    a diferença.

    <br><br>

    Esta é apenas uma simulação.
    Nenhuma informação foi armazenada.
    `;

    mensagem.style.color = "#2196F3";

    document.getElementById("desabafo").value = "";

}


// =========================
// QUIZ
// =========================

function corrigirQuiz() {

    let pontos = 0;

    let respostas = document.querySelectorAll("#quiz input[type=radio]:checked");

    respostas.forEach(function(item){

        pontos += Number(item.value);

    });

    let resultado = document.getElementById("resultado");

    resultado.innerHTML =
    "🎉 Você acertou <strong>" + pontos + "</strong> de 5 perguntas!";

    if (pontos == 5){

        resultado.innerHTML +=
        "<br>🏆 Parabéns! Você mandou muito bem!";

    }

    else if (pontos >= 3){

        resultado.innerHTML +=
        "<br>👏 Muito bom! Continue aprendendo.";

    }

    else{

        resultado.innerHTML +=
        "<br>📚 Continue estudando e tente novamente.";

    }

}


// =========================
// BOTÃO VOLTAR AO TOPO
// =========================

const botaoTopo = document.getElementById("topo");

window.onscroll = function () {

    if (document.documentElement.scrollTop > 250) {

        botaoTopo.style.display = "block";

    }

    else {

        botaoTopo.style.display = "none";

    }

};

function voltarTopo() {

    window.scrollTo({

        top: 0,

        behavior: "smooth"

    });

}

if (botaoTopo){

    botaoTopo.addEventListener("click", voltarTopo);

}


// =========================
// ANIMAÇÃO DOS CARDS
// =========================

const cards = document.querySelectorAll(".card");

cards.forEach(function(card){

    card.addEventListener("mouseenter", function(){

        card.style.transform = "translateY(-10px) scale(1.03)";

    });

    card.addEventListener("mouseleave", function(){

        card.style.transform = "translateY(0) scale(1)";

    });

});